<group name="opensearch_ad_alerts,">
    <!-- Broad catch-all for AD alerts -->
    <rule id="100300" level="5">
      <decoded_as>opensearch_ad</decoded_as>
      <description>OpenSearch AD alert received</description>
    </rule>

    <!-- Insider-threat specific -->
    <rule id="100301" level="12">
      <decoded_as>opensearch_ad</decoded_as>
      <match>Insider-Threat-Detected</match>
      <description>OpenSearch AD: Insider-Threat Detected</description>
    </rule>
</group>
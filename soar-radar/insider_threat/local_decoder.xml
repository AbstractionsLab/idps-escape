<decoder name="opensearch_ad">
  <program_name>^ad_alert$</program_name>
  <prematch>OpenSearchAD</prematch>
</decoder>

<decoder name="opensearch_ad_insider_threat">
  <parent>opensearch_ad</parent>
  <regex offset="after_parent">\s*Insider-Threat-Detected:\s*entity="(\S+)",\s*start="(\S+)",\s*end="(\S+)"</regex>
  <order>user_keyword,period_start,period_end</order>
</decoder>


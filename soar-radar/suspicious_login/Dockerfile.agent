FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV KEYCLOAK_VERSION=24.0.1
ENV KEYCLOAK_HOME=/opt/keycloak

# 1. Install system dependencies
RUN apt update && apt install -y \
    curl gnupg unzip default-jdk lsb-release apt-transport-https software-properties-common procps iptables

# 2. Install Wazuh agent using official repository
RUN curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --dearmor -o /usr/share/keyrings/wazuh-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/wazuh-archive-keyring.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list && \
    apt update && \
    apt install -y wazuh-agent=4.12.0-1

# 3. Download and unzip Keycloak
RUN curl -L -o /tmp/keycloak.zip https://github.com/keycloak/keycloak/releases/download/${KEYCLOAK_VERSION}/keycloak-${KEYCLOAK_VERSION}.zip && \
    unzip /tmp/keycloak.zip -d /opt && \
    mv /opt/keycloak-${KEYCLOAK_VERSION} ${KEYCLOAK_HOME} && \
    rm /tmp/keycloak.zip

# 4. Make sure the keycloak script is executable
RUN chmod +x ${KEYCLOAK_HOME}/bin/kc.sh

# 5. Set working directory
WORKDIR ${KEYCLOAK_HOME}

# 6. Expose the default Keycloak port
EXPOSE 8080

# 7. Default command to run Keycloak
ENTRYPOINT ["./bin/kc.sh"]
CMD ["start-dev"]
<decoder name="log_volume_metric">
  <program_name>log_volume_metric</program_name>
</decoder>

<decoder name="log_volume_metric_fields">
  <parent>log_volume_metric</parent>
  <prematch>ossec: output: 'log_volume_metric':\s*</prematch>
  <regex offset="after_prematch">(\S+) (\S+)</regex>
  <order>log_path, log_bytes</order>
</decoder>

<decoder name="opensearch_ad">
  <program_name>^ad_alert$</program_name>
  <prematch>OpenSearchAD</prematch>
</decoder>

<decoder name="opensearch_ad_detector">
  <parent>opensearch_ad</parent>
  <regex offset="after_parent">\s*(\S+):\s*entity="(\S+)",\s*start="(\S+)",\s*end="(\S+)"</regex>
  <order>detector_name,entity_keyword,period_start,period_end</order>
</decoder>
FROM python:3.10.12

ARG MY_ENV

ENV MY_ENV=${MY_ENV} \
  PYTHONFAULTHANDLER=1 \
  PYTHONUNBUFFERED=1 \
  PYTHONHASHSEED=random \
  PIP_NO_CACHE_DIR=off \
  PIP_DISABLE_PIP_VERSION_CHECK=on \
  PIP_DEFAULT_TIMEOUT=100 \
  POETRY_VERSION=1.5.0

ENV user=alab
ENV SOAR_FOLDER=soar

# Create a non-root user
RUN useradd -ms /bin/bash ${user}

# Add location where pip is installed to the PATH variable
ENV PATH="/home/${user}/.local/bin:${PATH}"

# Install poetry as user
USER ${user}
RUN pip3 install poetry=="${POETRY_VERSION}"

WORKDIR /home/${user}/${SOAR_FOLDER}

# Dependencies first, so source changes don't invalidate this layer.
# The sonar group declares everything SONAR imports; ADBox's dependencies (and the
# git-hosted opensearch-sdk-py) stay out of the image.
COPY --chown=${user}:${user} pyproject.toml poetry.lock README.md /home/${user}/${SOAR_FOLDER}/
RUN poetry install --only main,sonar --no-root

# Copy only what SONAR needs: never `COPY .`, which would include adbox/assets/secrets
# and any .env file (see sonar/Dockerfile.sonar.dockerignore).
COPY --chown=${user}:${user} sonar /home/${user}/${SOAR_FOLDER}/sonar
COPY --chown=${user}:${user} adbox/__init__.py /home/${user}/${SOAR_FOLDER}/adbox/__init__.py
RUN poetry install --only-root

ENV PYTHONPATH=/home/${user}/${SOAR_FOLDER}

# The sonar console script (sonar.cli:main). The image is a source checkout (pyproject.toml
# next to sonar/), so the SONAR home is sonar/: models in sonar/models (mounted by sonar.sh).
ENTRYPOINT ["poetry", "run", "sonar"]

# Default command (can be overridden)
CMD ["--help"]

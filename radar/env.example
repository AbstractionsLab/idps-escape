# =======================================================================
# RADAR environment configuration
# =======================================================================

# =======================
# OpenSearch / Wazuh Indexer
# =======================
# The GUI and CLI scripts run on this machine and reach the indexer via
# the port Docker publishes to this machine (9200). Use localhost unless
# you are running the GUI/CLI from a different machine than the one
# running docker compose, in that case, use that machine's IP instead.
OS_URL=https://localhost:9200
OS_USER=admin
OS_PASS=SecretPassword
# false = skip certificate verification (fine for local/test use).
# true  = verify against this machine's system CA bundle.
OS_VERIFY_SSL=false
# OS_VERIFY_SSL=./config/wazuh_indexer_ssl_certs/root-ca.pem

# =======================
# Wazuh Dashboard
# =======================
# Same reachability rule as OS_URL above. Docker publishes the dashboard
# on port 443 of this machine.
DASHBOARD_URL=https://localhost
DASHBOARD_USER=admin
DASHBOARD_PASS=SecretPassword
DASHBOARD_VERIFY_SSL=false
# DASHBOARD_VERIFY_SSL=./config/wazuh_indexer_ssl_certs/root-ca.pem

# =======================
# Wazuh API
# =======================
# Same reachability rule as OS_URL above. Docker publishes the Wazuh API
# on port 55000 of this machine. WAZUH_AUTH_USER/PASS must match a real
# Wazuh API user, the defaults below match what docker-compose.core.yml
# provisions out of the box; change them if you've changed those.
WAZUH_API_URL=https://localhost:55000
WAZUH_AUTH_USER=wazuh-wui
WAZUH_AUTH_PASS=MyS3cr37P450r.*-

# =======================
# Wazuh agent / manager
# =======================
# Pinned agent package version bootstrap-agent.sh installs. Leave as-is
# unless you have a specific reason to pin a different Wazuh version.
WAZUH_AGENT_VERSION=4.14.1-1

# Wazuh manager cluster key (config/wazuh_cluster/wazuh_manager.conf --
# a reference template, not auto-deployed -- documents this as
# ${WAZUH_CLUSTER_KEY}). Only relevant if you manually enable multi-node
# clustering; it's disabled by default and nothing here does that for
# you. Leave blank unless you're setting up clustering yourself, in which
# case generate a fresh random value (e.g. `openssl rand -hex 16`)
WAZUH_CLUSTER_KEY=

# This is different from the URLs above: it is read *inside* the webhook
# container.
WAZUH_MANAGER_ADDRESS=

# Read inside the manager container, over the manager's own internal
# Docker network. This is a Docker service name, not this machine's
# address, and normally doesn't need to change.
WAZUH_INDEXER_HOST=https://wazuh.indexer:9200

# =======================
# Webhook
# =======================
# Same reachability rule as OS_URL above: this is read by the CLI/GUI on
# this machine to reach the webhook's published port (8080).
WEBHOOK_NAME="RADAR_Webhook"
WEBHOOK_URL=http://localhost:8080/notify

# =======================
# Active response logging (internal manager paths)
# =======================
# Paths *inside the manager container* where radar_ar.py runs. These match
# the standard Wazuh layout and normally don't need to change.
AR_LOG_FILE=/var/ossec/logs/active-responses.log
AR_RISK_CONFIG=/var/ossec/active-response/bin/ar.yaml

# =======================
# SMTP (email alerts for tier 1+ active responses)
# =======================
# Standard SMTP credentials for whatever mail provider/relay you use.
# EMAIL_TO is who receives RADAR's alert emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_TO=soc-team@example.com
SMTP_STARTTLS=yes

# =======================
# DECIPHER (optional, CTI enrichment and FlowIntel case creation)
# =======================
# Leave DECIPHER_BASE_URL empty/unset to run without CTI enrichment --
# active responses still work, just without the CTI score component and
# without FlowIntel case creation. If you do have a DECIPHER instance
# running, point this at it (reachable from this machine).
DECIPHER_BASE_URL=
DECIPHER_VERIFY_SSL=false
DECIPHER_TIMEOUT_SEC=30

# =======================
# MaxMind GeoLite2 (required for suspicious_login and geoip_detection)
# =======================
# Free account + license key from:
#   https://www.maxmind.com/en/geolite2/signup
# Generate the key from the account's "My License Key" page, then paste
# it here. The manager downloads the GeoIP databases itself on deploy --
# nothing else to do once this is set.
MAXMIND_LICENSE_KEY=CHANGE_ME

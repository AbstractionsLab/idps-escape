{
  "index_patterns": ["wazuh-ad-log-volume-*"],
  "priority": 400,
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "agent": {
          "properties": {
            "name": { "type": "keyword" },
            "id":   { "type": "keyword" }
          }
        },
        "data": {
          "properties": {
            "log_path":  { "type": "keyword" },
            "log_bytes": { "type": "long" }
          }
        },
        "predecoder": {
          "properties": {
            "program_name": { "type": "keyword" }
          }
        }
      }
    }
  }
}

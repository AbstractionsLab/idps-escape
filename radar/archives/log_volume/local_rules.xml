<group name="opensearch_ad_alerts,">

  <!-- 1) Catch-all for any OpenSearch AD alert -->
  <rule id="100300" level="5">
    <decoded_as>opensearch_ad</decoded_as>
    <description>OpenSearch AD alert received</description>
  </rule>

  <!-- 2) Only if it was ‘LogVolume-Growth-Detected’ -->
  <rule id="100309" level="12">
    <if_sid>100300</if_sid>
    <match>LogVolume-Growth-Detected</match>
    <description>OpenSearch AD: Log Volume Growth Detected</description>
  </rule>
</group>





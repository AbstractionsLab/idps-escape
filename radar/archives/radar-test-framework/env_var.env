# =======================
# OpenSearch Configuration
# =======================
OPENSEARCH_URL=https://wazuh.indexer:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=SecretPassword
OPENSEARCH_VERIFY_SSL=/etc/ssl/root-ca.pem

# =======================
# Keycloak Configuration
# =======================
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=demo
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=secret
KEYCLOAK_USERNAME=220
KEYCLOAK_PASSWORD=testpass

# =======================
# Wazuh Configuration
# =======================
WAZUH_URL=https://localhost
WAZUH_USER=admin
WAZUH_PASS=SecretPassword
WAZUH_VERIFY_SSL=False

# =======================
# Webhook (for Active Response or Enrichment)
# =======================
WEBHOOK=RADAR
WEBHOOK_URL=http://ad-webhook:8888/opensearch-alert

# =======================
# Misc
# =======================
GEOIP_DB_PATH=simulate/geoip/GeoLite2-City.mmdb
LOG_DIR=/tmp/logs

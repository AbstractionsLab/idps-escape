<decoder name="opensearch_ad">
  <program_name>^ad_alert$</program_name>
  <prematch>OpenSearchAD</prematch>
</decoder>

<decoder name="opensearch_ad_detector">
  <parent>opensearch_ad</parent>
  <regex offset="after_parent">\s*(\S+):\s*entity="(\S+)",\s*start="(\S+)",\s*end="(\S+)",\s*anomaly_grade="(\S+)",\s*anomaly_confidence="(\S+)"</regex>
  <order>detector_name,entity_keyword,period_start,period_end,anomaly_grade,anomaly_confidence</order>
</decoder>
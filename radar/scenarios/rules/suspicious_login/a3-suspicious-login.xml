<group name="suspicious_login,">

  <!-- 1) Rule for failed burst logins -->
  <rule id="210013" level="8" timeframe="60" frequency="5">
    <if_matched_sid>5760</if_matched_sid>
    <same_user />
    <description>RADAR SuspiciousLogin: failed-burst (≥5 in 60s)</description>
    <group>authentication_failures,brute_force</group>
  </rule>

  <!-- 2) Rule for impossible travel -->
  <rule id="210020" level="10">
    <if_group>authentication_failed</if_group>
    <field name="radar_geo_velocity_kmh" type="pcre2">^(?:9(?:0[1-9]|[1-9]\d)|[1-9]\d{3,})(?:\.\d+)?$</field>
    <description>RADAR SuspiciousLogin: impossible travel with failure (≥900 km/h + country change)</description>
    <group>authentication_failed,impossible_travel,geo</group>
  </rule>
  <rule id="210021" level="10">
    <if_group>authentication_success</if_group>
    <field name="radar_geo_velocity_kmh" type="pcre2">^(?:9(?:0[1-9]|[1-9]\d)|[1-9]\d{3,})(?:\.\d+)?$</field>
    <description>RADAR SuspiciousLogin: impossible travel (≥900 km/h + country change)</description>
    <group>authentication_success,impossible_travel,geo</group>
  </rule>

  <!-- 3) Composite correlation rule: failed burst followed by impossible travel -->
  <rule id="210022" level="12" frequency="4" timeframe="300">
    <if_sid>210021</if_sid>
    <if_matched_sid>5760</if_matched_sid>
    <same_user />
    <description>RADAR SuspiciousLogin: credential compromise (failed-burst + impossible-travel within 5min)</description>
    <group>authentication_success,impossible_travel,brute_force,credential_compromise</group>
  </rule>

  <!-- O365 login failure base event -->
  <rule id="210030" level="5">
    <if_sid>91545</if_sid>
    <match>UserLoginFailed</match>
    <options>no_full_log</options>
    <description>RADAR SuspiciousLogin: O365 login failure</description>
    <group>authentication_failed,AzureActiveDirectoryStsLogon,hipaa_164.312.a.2.I,hipaa_164.312.b,hipaa_164.312.d,hipaa_164.312.e.2.II,pci_dss_8.3,pci_dss_10.6.1</group>
  </rule>
 
  <!-- O365 brute force: ≥3 failures in 300s, same UserId -->
  <rule id="210031" level="10" frequency="3" timeframe="300">
    <if_matched_sid>210030</if_matched_sid>
    <same_field>office365.UserId</same_field>
    <options>no_full_log</options>
    <description>RADAR SuspiciousLogin: O365 brute force (≥3 in 300s) for $(office365.UserId)</description>
    <group>authentication_failed,brute_force,AzureActiveDirectoryStsLogon,hipaa_164.312.a.2.I,hipaa_164.312.b,hipaa_164.312.d,hipaa_164.312.e.2.II,pci_dss_8.3,pci_dss_10.6.1</group>
  </rule>

</group>
<group name="opensearch_ad_alerts,suspicious_login,">

  <!-- Catch-all for any OpenSearch AD alert, so the off-hour rule below also
       fires when suspicious_login is deployed without an AD scenario. Children
       attach through the radar_ad_received group: see a1-log-volume.xml. -->
  <rule id="210039" level="5">
    <decoded_as>opensearch_ad</decoded_as>
    <location>/var/log/ad_alerts.log$</location>
    <description>OpenSearch AD alert received</description>
    <group>radar_ad_received,</group>
  </rule>

  <!-- Off-hours model mode: per-user AD detector on the count of off-hours events
       (entity = user). off_hours.py keeps this trigger name; renaming it breaks this match. -->
  <rule id="210040" level="10">
    <if_group>radar_ad_received</if_group>
    <match>SuspiciousLogin-OffHour-Detected</match>
    <description>RADAR SuspiciousLogin: off-hour login activity for user $(entity_keyword)</description>
    <group>off_hour_login,</group>
  </rule>

  <!-- Off-hours rule mode: an OpenSearch Alerting query monitor on radar.off_hours
       (declared schedules, scenarios.suspicious_login.off_hours in config.yaml).
       The trigger name is fixed in off_hours.py; renaming it breaks this match. -->
  <rule id="210041" level="10">
    <if_group>radar_ad_received</if_group>
    <match>SuspiciousLogin-OffHours-Rule-Detected</match>
    <description>RADAR SuspiciousLogin: off-hours activity for user $(entity_keyword) outside the declared schedule</description>
    <group>off_hour_login,off_hours_rule_mode,</group>
  </rule>
</group>

<group name="opensearch_ad_alerts,">

  <!-- 1) Catch-all for any OpenSearch AD alert.
       Every AD scenario ships a catch-all like this one, and Wazuh stops at the
       first top-level rule that matches, so only the first one loaded ever fires.
       Children therefore attach through the radar_ad_received group (if_group),
       not if_sid, to stay reachable whichever catch-all wins. -->
  <rule id="100300" level="5">
    <decoded_as>opensearch_ad</decoded_as>
    <location>/var/log/ad_alerts.log$</location>
    <description>OpenSearch AD alert received</description>
    <group>radar_ad_received,</group>
  </rule>

  <!-- 2) Only if it was ‘LogVolume-Growth-Detected’ -->
  <rule id="100309" level="12">
    <if_group>radar_ad_received</if_group>
    <match>LogVolume-Growth-Detected</match>
    <description>OpenSearch AD: Log Volume Growth Detected</description>
  </rule>
</group>

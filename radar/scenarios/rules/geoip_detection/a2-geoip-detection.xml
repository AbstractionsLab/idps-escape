<group name="geo_block">
  <rule id="100900" level="10">
    <if_group>authentication_success</if_group>
    <field name="radar_country" type="pcre2">.+</field>
    <list field="radar_country" lookup="not_match_key">etc/lists/whitelist_countries</list>
    <description>Connection from non-whitelist country</description>
  </rule>
  <rule id="100901" level="10">
    <if_group>authentication_success</if_group>
    <srcgeoip negate="yes">Luxembourg|France|Germany|Belgium</srcgeoip>
    <description>Connection from non-whitelist country</description>
  </rule>
  <rule id="100902" level="10">
    <if_group>accesslog</if_group>
    <field name="radar_country" type="pcre2">.+</field>
    <list field="radar_country" lookup="not_match_key">etc/lists/whitelist_countries</list>
    <description>Connection from non-whitelist country</description>
  </rule>
  <rule id="100903" level="12" frequency="300" timeframe="300">
    <if_matched_sid>100902</if_matched_sid>
    <description>High number of connections from non-whitelist countries</description>
  </rule>
</group>